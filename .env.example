# Your GitHub user login. Installations on any other account are rejected.
OWNER_LOGIN=
# GitHub App ID, from the App's settings page.
GITHUB_APP_ID=
# Path on this machine to the App's private key (.pem). Defaults to ./github-app.pem.
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
# Dashboard password for user "admin".
ADMIN_PASSWORD=
# Host port for the dashboard (bound to 127.0.0.1).
PORT=3000
