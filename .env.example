# Your GitHub user login. Installations on any other account are rejected.
OWNER_LOGIN=
# GitHub App ID, from the App's settings page.
GITHUB_APP_ID=
# Path on this machine to the App's private key (.pem). Defaults to ./github-app.pem.
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
# Dashboard password for user "admin".
ADMIN_PASSWORD=
# Host port for the dashboard (bound to 127.0.0.1).
PORT=3000
# Claude Code subscription token from `claude setup-token` (only if you pick Claude Code on the setup page).
CLAUDE_CODE_OAUTH_TOKEN=
# Post the agent's questions as an issue comment when an issue is too vague to brief. Needs the App's Issues write permission.
COMMENT_QUESTIONS=false
# Group ID that owns the Docker socket on the host (Linux: stat -c %g /var/run/docker.sock). 0 works on Docker Desktop.
DOCKER_GID=0
