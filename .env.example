# Required: Your personal GitHub user login (e.g. octocat). Installations on any other account are rejected.
OWNER_LOGIN=

# Required: GitHub App ID, from the App's General settings page.
GITHUB_APP_ID=

# Optional: Path on this host machine to the App's private key (.pem). Defaults to ./github-app.pem.
# Mounted as a Docker secret into the controller container at /run/secrets/github_app_key.
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem

# Required: Dashboard password for user "admin".
ADMIN_PASSWORD=

# Optional: Host port for the dashboard (bound to 127.0.0.1). Defaults to 3000.
PORT=3000

# Optional: Claude Code subscription OAuth token from `claude setup-token` (required if Claude Code is selected on the setup page).
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: Post the agent's questions as an issue comment when an issue is too vague to brief (needs_info).
# Defaults to false. Requires the GitHub App's "Issues" permission set to "Read and write".
COMMENT_QUESTIONS=false

# Optional: Group ID that owns the Docker socket on the host (Linux: stat -c %g /var/run/docker.sock).
# Defaults to 0 (works on Docker Desktop for macOS and Windows).
DOCKER_GID=0

# Optional: Public HTTPS URL for the service (e.g. https://auto-solve.example.com).
# Paired with WEBHOOK_SECRET to enable immediate issue intake via GitHub webhooks.
PUBLIC_URL=

# Optional: GitHub App webhook secret.
# Paired with PUBLIC_URL; configure the same secret in your GitHub App's webhook settings.
WEBHOOK_SECRET=
